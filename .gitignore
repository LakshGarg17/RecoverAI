# RecoverAI .gitignore

# Environment & Local Configuration
.env
.env.local
.env.*.local
*.env

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml

# Databases & Local Logs
*.sqlite3
*.db
recoverai_dev.db
*.log

# Node.js & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js Build Output
frontend/.next/
frontend/out/

# IDE & OS Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Data Layer (Kaggle Raw & Processed Output)
# NOTE: Raw Kaggle dataset and generated processed dataset are untracked.
# Only curated samples in data/samples/ are tracked in git.
data/raw/
data/processed/
!data/samples/
