# ==============================================================================
# RecoverAI — Environment Variables Configuration (.env.example)
# Copy this file to .env in your root, backend, and/or frontend as needed
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Backend Base API URL
API_V1_STR=/api/v1
PROJECT_NAME="RecoverAI Autonomous Payment Recovery Agent"

# CORS Configuration (comma-separated origins or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database Connection (PostgreSQL / Supabase / Neon or local fallback)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recoverai

# AI Configuration (OpenAI API)
OPENAI_API_KEY=sk-placeholder-openai-key-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Razorpay Test Mode Configuration
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_here
RAZORPAY_CURRENCY=INR
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Frontend Configuration (used by Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="RecoverAI"
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
